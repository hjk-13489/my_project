+{% extends 'base.html' %}
+
+{% block title %}首页 - 校园二手书交易平台{% endblock %}
+
+{% block content %}
+<div class="text-center mt-5">
+    <h1>欢迎来到校园二手书交易平台</h1>
+
+    {% if user.is_authenticated %}
+        {% if not user.is_verified %}
+            <div class="alert alert-warning mt-4" role="alert">
+                <strong>待认证</strong> — 你的账号尚未完成学号认证，部分功能将受限。请等待管理员审核。
+            </div>
+        {% else %}
+            <div class="alert alert-success mt-4" role="alert">
+                你的账号已通过认证，可以正常使用所有功能。
+            </div>
+        {% endif %}
+    {% else %}
+        <p class="lead mt-4">请注册或登录以使用平台功能。</p>
+        <div class="mt-3">
+            <a href="{% url 'register' %}" class="btn btn-primary me-2">注册</a>
+            <a href="#" class="btn btn-outline-primary">登录</a>
+        </div>
+    {% endif %}
+</div>
+{% endblock %}
